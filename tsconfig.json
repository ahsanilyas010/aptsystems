{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@kamai/*": ["src/kamai/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/router.tsx"],
  "exclude": ["node_modules", "dist", "apt-orders-app", "src/APT_CRM_v3.1.jsx"]
}
