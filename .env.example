# Environment Variables — copy this to .env.local and fill in your values
# .env.local is NEVER committed to git

# ── SERVER-SIDE (Vercel Environment Variables — no VITE_ prefix) ──────────────
# These are used by the /api/gas.js serverless proxy function.
# Set these in: Vercel Dashboard → Project → Settings → Environment Variables
GAS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
API_KEY=YOUR_GAS_API_SECRET_KEY

# ── Firebase Auth (Client-side — VITE_ prefix required) ──────────────────────
VITE_FIREBASE_API_KEY=AIzaSy_YOUR_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id

# ── apt-rider-connect proxy (Server-side — no VITE_ prefix, used by /api/supabase.js) ──
# /api/supabase.js forwards Rider Hub requests to apt-rider-connect's /rider-admin
# server route, which holds the real Supabase service role key. Auth between the
# two apps is a shared secret — set the SAME value for ADMIN_SYNC_KEY in both
# this project's Vercel env vars and apt-rider-connect's (Lovable Cloud Secrets).
# NOTE: must be /rider-admin, not /api/admin — Lovable Cloud reserves the /api/*
# path prefix for internal routing, so requests to /api/admin return the SPA's
# HTML instead of executing the server route.
RIDER_CONNECT_API_URL=https://your-apt-rider-connect-domain/rider-admin
ADMIN_SYNC_KEY=generate-a-long-random-shared-secret

# ── Supabase (shared project used by apt-rider-connect, apt-finance and Kamai OS) ──
# Client-side (VITE_ prefix). Both have built-in fallbacks in src/kamai/lib/supabase.ts;
# the anon key is a public publishable key (RLS protects the data).
VITE_SUPABASE_URL=https://aliegtwlfphpeyvesyvi.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only (used by /api/invoice.js, /api/supabase.js and the Kamai admin API).
# NEVER expose the service role key to the browser.
SUPABASE_URL=https://aliegtwlfphpeyvesyvi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Invoice API (/api/invoice.js) ─────────────────────────────────────────────
# Shared secret callers must send to generate invoices.
INV_API_KEY=generate-a-long-random-secret
# Google Drive upload for invoice PDFs (OAuth refresh-token flow)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# ── WhatsApp Cloud API (Kamai OS; server-side only, no VITE_ prefix) ──────────
# From Meta for Developers -> WhatsApp -> API setup.
WHATSAPP_ACCESS_TOKEN=system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WABA_ID=your-whatsapp-business-account-id
# App secret: used to verify the X-Hub-Signature-256 header on inbound webhooks.
WHATSAPP_APP_SECRET=your-meta-app-secret
# Any random string; must match the verify token entered in the Meta webhook config.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate-a-random-string
WHATSAPP_GRAPH_VERSION=v25.0
